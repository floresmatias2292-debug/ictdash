# Copy this file to .env (same folder as run.sh) and fill ONE key. Restart the dashboard after editing.

# twitterapi.io — cheapest (~$0.15 per 1,000 tweets). Sign up at https://twitterapi.io, copy the API key.
TWITTERAPI_IO_KEY=

# Official X API v2 (pay-per-use, ~$0.005 per tweet read). https://developer.x.com → app → Bearer Token.
X_BEARER_TOKEN=

# Optional
# X_PROVIDER=twitterapi        # or: x   (only needed if both keys are set)
# X_POLL_SEC=300               # seconds between reads (minimum 60)
# X_DAILY_CAP=3000             # max tweets read per UTC day (default 3000 twitterapi.io, 200 X API)
