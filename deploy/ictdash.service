[Unit]
Description=FVG-ICT dashboard (Binance / Hyperliquid 24/7 charts) on http://127.0.0.1:8050
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Paths are filled in by deploy/install-service.sh
WorkingDirectory=__DIR__
ExecStart=__DIR__/run.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
